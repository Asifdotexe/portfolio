      "isDeleted": false,
      "boundElements": null,
      "updated": 1783405280694,
      "link": null,
      "locked": false,
      "text": "Bullet Points for AEO: Answer Engines love extracting\nbulleted lists. Instead of a paragraph for the \"Problem\nStatement,\" structure it as:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bullet Points for AEO: Answer Engines love extracting bulleted lists. Instead of a paragraph for the \"Problem Statement,\" structure it as:",
      "autoResize": false,
      "lineHeight": 1.25
    },
