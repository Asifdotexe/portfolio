      "type": "text",
      "x": 1078.8282219677144,
      "y": 3120.3990539091387,
      "width": 738.4718017578125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
