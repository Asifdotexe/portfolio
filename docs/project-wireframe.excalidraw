      "isDeleted": false,
      "boundElements": null,
      "updated": 1783405283547,
      "link": null,
      "locked": false,
      "text": "Semantic HTML Elements: Ensure your title is an <h1>,\nyour main sections are <h2>, and your tags/skills are\nwrapped in semantic lists (<ul>/<li>) rather than just\nfloating <span> tags.",
      "fontSize": 28.000000000000004,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Semantic HTML Elements: Ensure your title is an <h1>, your main sections are <h2>, and your tags/skills are wrapped in semantic lists (<ul>/<li>) rather than just floating <span> tags.",
      "autoResize": false,
      "lineHeight": 1.25
    },
