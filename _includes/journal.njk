---
layout: base.njk
---
<article class="journal active" data-page="journal-post">
    <header>
        <h2 class="h2 article-title">Journal</h2>
    </header>
    <section class="journal-content-section">
        <h1 class="journal-post-title" style="color: var(--white-1); font-size: 24px; margin-bottom: 10px;">{{ title }}</h1>
        <a href="/journal/" class="journal-back-btn" style="display: inline-block; margin-bottom: 20px; color: var(--vibrant-green); text-decoration: none; font-weight: 500;">← Back to Journal</a>
        
        {% if date %}
        <div style="color: var(--light-gray-70); font-size: 14px; margin-bottom: 20px;">
            Published: {{ date }}
        </div>
        {% endif %}
        
        <div class="journal-post-content" style="color: var(--light-gray); line-height: 1.6;">
            {{ content | safe }}
        </div>
    </section>
</article>
