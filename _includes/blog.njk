---
layout: base.njk
---
<article class="blogs active" data-page="blog-post">
    <header>
        <h2 class="h2 article-title">Blogs</h2>
    </header>
    <section class="blog-content-section">
        <h1 class="blog-post-title">{{ title }}</h1>
        <a href="/blogs/" class="blog-back-btn" style="display: inline-block; margin-bottom: 20px; color: var(--vibrant-green); text-decoration: none;">← Back to Blogs</a>
        
        {% if date %}
        <div style="color: var(--light-gray-70); font-size: 14px; margin-bottom: 20px;">
            Published: {{ date }}
        </div>
        {% endif %}
        
        <div class="blog-post-content">
            {{ content | safe }}
        </div>
    </section>
</article>
