                    <section class="timeline">
                        <div class="title-wrapper">
                            <div class="icon-box">
                                <ion-icon
                                    aria-hidden="true"
                                    name="logo-github"
                                ></ion-icon>
                            </div>
                            <h3 class="h3">GitHub Contributions</h3>
                        </div>
                        <div class="contribution-chart">
                            <img
                                src="https://ghchart.rshah.org/Asifdotexe"
                                alt="Asifdotexe's Github chart"
                                loading="lazy"
                            />
                        </div>
                    </section>
                    <section
                        class="cwo-section timeline"
                        style="margin-top: 30px"
                    >
                        <div class="title-wrapper">
                            <div class="icon-box">
                                <ion-icon
                                    aria-hidden="true"
                                    name="git-branch-outline"
                                ></ion-icon>
                            </div>
                            <h3 class="h3">Latest Activity</h3>
                        </div>
                        <div id="cwo-content">
                            <!-- Populated by JS -->
                            <noscript>
                                <p
                                    class="timeline-text"
                                    style="
                                        color: var(--light-gray-70);
                                        margin-top: 15px;
                                    "
                                >
                                    Please enable JavaScript to view latest
                                    GitHub activity.
                                </p>
                            </noscript>
                        </div>
                    </section>

                    <section class="timeline">
                        <div class="title-wrapper">
                            <div class="icon-box">
                                <ion-icon
                                    aria-hidden="true"
                                    name="bar-chart"
                                ></ion-icon>
                            </div>
                            <h3 class="h3">Experience</h3>
                        </div>

                        
    <ol class="timeline-list">
        {% for exp in experience %}
        <li class="timeline-item">
            <h4 class="h4 timeline-item-title">{{ exp.role }}</h4>
            <span>{{ exp.date }}</span>
            <p class="timeline-text">{{ exp.description }}</p>
        </li>
        {% endfor %}
    </ol>
    </section>

                    <section class="timeline">
                        <div class="title-wrapper">
                            <div class="icon-box">
                                <ion-icon
                                    aria-hidden="true"
                                    name="book"
                                ></ion-icon>
                            </div>
                            <h3 class="h3">Education</h3>
                        </div>
                        
    <ol class="timeline-list">
        {% for edu in education %}
        <li class="timeline-item">
            <h4 class="h4 timeline-item-title">{{ edu.institution }}</h4>
            <span>{{ edu.duration }}</span>
            <p class="timeline-text">{{ edu.description }}</p>
        </li>
        {% endfor %}
    </ol>
    </section>
                </article>